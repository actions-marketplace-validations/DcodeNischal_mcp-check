{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-check",
  "main": "./src/worker/index.ts",
  // Only reachable at its own domain, not also at a workers.dev address.
  "workers_dev": false,
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    // The Vue app; unknown paths fall back to it so client-side routes work.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/badge/*", "/r/*", "/p/*", "/oauth/*", "/mcp", "/.well-known/mcp-check.txt", "/servers", "/sitemap.xml", "/feed.xml"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mcp-check", "database_id": "cda69cf7-7c20-41d2-9238-924f3041040f" }
  ],
  // Meaning search: Workers AI embeddings stored in Vectorize (see src/worker/search.ts).
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "mcp-servers" }],
  // Live checks per visitor: 20 a minute (the period can only be 10 or 60 seconds).
  "ratelimits": [
    { "name": "CHECK_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  // Turnstile tokens must come from this hostname. The secret is a Worker secret (TURNSTILE_SECRET).
  "vars": { "TURNSTILE_HOSTNAMES": "mcp.nischaldhakal.com.np" },
  // Every five minutes: search upkeep, registry sync, and checks of queued servers, within daily budgets
  // (see tick in src/worker/index.ts and src/worker/budget.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // A binding to this Worker's own Checker entrypoint: the cron run checks several servers at once,
  // each as its own invocation. It's an RPC method, not an HTTP route, so it can't be called from outside.
  "services": [
    { "binding": "CHECKER", "service": "mcp-check", "entrypoint": "Checker" },
    // The Worker itself, so checks can reach its own hostname (its own MCP server at /mcp).
    { "binding": "SELF", "service": "mcp-check" }
  ],
  "observability": { "enabled": true }
}
